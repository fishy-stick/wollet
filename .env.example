# Required administrator credentials. Use a unique password with at least 12 characters.
WOLLET_ADMIN_USERNAME=admin
WOLLET_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional IPv4 broadcast address. The limited broadcast address works for most single-LAN setups.
WOLLET_WOL_BROADCAST=255.255.255.255

# Optional service settings.
WOLLET_LISTEN_ADDR=0.0.0.0:8080
WOLLET_DB_PATH=/data/wollet.db
WOLLET_WOL_PORT=9
WOLLET_LOG_LEVEL=info

# UID/GID used by Docker Compose for the bind-mounted ./data directory.
WOLLET_UID=1000
WOLLET_GID=1000
