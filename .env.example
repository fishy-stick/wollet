# Required administrator credentials. Use a unique password with at least 12 characters.
WAKELET_ADMIN_USERNAME=admin
WAKELET_ADMIN_PASSWORD=replace-with-a-long-random-password

# Directed IPv4 broadcast address for the server's LAN.
WAKELET_WOL_BROADCAST=192.168.1.255

# Optional service settings.
WAKELET_LISTEN_ADDR=0.0.0.0:8080
WAKELET_DB_PATH=/data/wakelet.db
WAKELET_WOL_PORT=9
WAKELET_LOG_LEVEL=info

# UID/GID used by Docker Compose for the bind-mounted ./data directory.
WAKELET_UID=1000
WAKELET_GID=1000
